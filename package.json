    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "globals": "latest",
    "jest": "latest",
    "prettier": "latest",
    "ts-jest": "latest",
    "typescript": "~5.9.2",
    "typescript-eslint": "latest"
  },
  "overrides": {
    "postcss": "^8.5.14"
  }
